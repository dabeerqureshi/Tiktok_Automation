# ============================================================
# TikTok Riddle Automation — Environment Configuration
# Copy this file to .env and fill in your values.
# ============================================================

# ---- Google Drive ----
# Root Google Drive folder name (case-insensitive; typo-tolerant)
GDRIVE_ROOT_FOLDER_NAME="AI Automation TikTok"

# Optional: Paste the folder ID directly to skip search on every startup
# GDRIVE_ROOT_FOLDER_ID=""

# ---- Google Sheets (Riddle Metadata) ----
# Sheet ID or full URL:
SHEET_ID="16qhYVieRF96VIyumNTovMkDs9j6ZFfVt-Udr_-MoKSY"
SHEET_GID="1298536790"
SHEET_NAME=""

# 0-based column indices:
# Col A (0): AI Prompt (informational)
# Col B (1): Riddle Answer
# Col C (2): Riddle Explanation
SHEET_COL_ANSWER=1
SHEET_COL_EXPLANATION=2

# How long (seconds) to cache the full sheet before re-fetching
SHEET_CACHE_TTL=60

# ---- Auth Files ----
CREDENTIALS_FILE="./credentials.json"
# SERVICE_ACCOUNT_FILE="./service_account.json"

# ---- Video Segment Durations (seconds) ----
COUNTDOWN_DURATION=40
SOLUTION_DURATION=5
EXPLANATION_DURATION=10

# ---- Content & Monetization Safety ----
# Minimum total video length — countdown auto-extends if the render is shorter
# (keeps every upload eligible for TikTok's longer-video rewards program)
MIN_TOTAL_DURATION=61
# Hard cap for uploaded AI clips (rejects anything longer before rendering)
AI_CLIP_MAX_DURATION=10
# Permanent AI-generated content watermark (required for TikTok monetization)
AI_LABEL_ENABLED=true
AI_LABEL_TEXT="AI GENERATED"
# End-of-video follow CTA
ENABLE_END_CTA=true
END_CTA_TEXT="Follow for more riddles!"

# ---- TTS Engine ----
# Options: "edge-tts" (recommended, free Microsoft neural voice)
#          "macos_say" (built-in macOS native offline speech)
#          "pyttsx3"  (offline fallback)
TTS_ENGINE="edge-tts"
TTS_VOICE="en-US-GuyNeural"

# ---- Ollama (Local LLM) ----
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="llama3.2:3b"
OLLAMA_MAX_TOKENS=120
OLLAMA_FALLBACK=true

# ---- Music ----
COUNTDOWN_MUSIC_VOLUME=0.4

# ---- Daemon Behavior ----
POLL_INTERVAL_SECONDS=30
CLEANUP_AFTER_UPLOAD=true

# ---- Failure Handling & Retries ----
# Max render attempts before a file is paused (re-enabled by replacing the
# source file in Drive, which changes its md5)
MAX_RENDER_ATTEMPTS=3
# Backoff delays between retries (seconds): ~5min -> 30min -> 2h
RETRY_BACKOFF_DELAYS=300,1800,7200
